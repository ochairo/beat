{
  "name": "@ochairo/beat",
  "version": "1.6.6",
  "description": "Pulse-native SPA runtime for DOM-first applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && pnpm build:minify",
    "build:minify": "esbuild dist/index.js --outdir=dist --format=esm --allow-overwrite --minify --legal-comments=none --tree-shaking=true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "beat",
    "pulse",
    "spa",
    "dom",
    "ochairo"
  ],
  "author": "ochairo",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ochairo/beat"
  },
  "homepage": "https://ochairo.github.io/beat-site/",
  "bugs": {
    "url": "https://github.com/ochairo/beat/issues"
  },
  "dependencies": {
    "@ochairo/pulse": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.7",
    "typescript": "^5.3.3",
    "vite": "^7.1.9",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
